{
  "uid": "shoplite-overview",
  "title": "ShopLite - Host & App Overview",
  "tags": ["shoplite", "observability"],
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-30m", "to": "now" },
  "schemaVersion": 41,
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "CPU usage",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "CPU busy",
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[1m])))" }
      ]
    },
    {
      "id": 2, "type": "timeseries", "title": "RAM usage",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "RAM used",
          "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)" }
      ]
    },
    {
      "id": 3, "type": "timeseries", "title": "Disk usage (/)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "Disk used",
          "expr": "100 * (1 - node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"})" }
      ]
    },
    {
      "id": 4, "type": "timeseries", "title": "Network traffic",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 8, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "{{device}} in",
          "expr": "rate(node_network_receive_bytes_total{device=~\"enp0s3|eth1\"}[1m])" },
        { "refId": "B", "legendFormat": "{{device}} out",
          "expr": "rate(node_network_transmit_bytes_total{device=~\"enp0s3|eth1\"}[1m])" }
      ]
    },
    {
      "id": 5, "type": "timeseries", "title": "Requests per second",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 8, "y": 8, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "{{status}}",
          "expr": "sum by (status) (rate(http_requests_total{route!~\"/health|/metrics\"}[1m]))" }
      ]
    },
    {
      "id": 6, "type": "timeseries", "title": "Error rate (5xx)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 16, "y": 8, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "5xx errors",
          "expr": "100 * (sum(rate(http_requests_total{status=~\"5..\"}[5m])) or vector(0)) / sum(rate(http_requests_total[5m]))" }
      ]
    },
    {
      "id": 7, "type": "timeseries", "title": "Latency p95",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "p95",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))" }
      ]
    },
    {
      "id": 8, "type": "timeseries", "title": "Orders created (last 5 min)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "{{payment_method}}",
          "expr": "sum by (payment_method) (increase(orders_created_total[5m]))" }
      ]
    },
    {
      "id": 9, "type": "logs", "title": "Order-worker errors (Kubernetes logs)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "x": 0, "y": 24, "w": 24, "h": 10 },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending" },
      "targets": [
        { "refId": "A",
          "expr": "{namespace=\"shop-worker\"} |= \"level=ERROR\"" }
      ]
    }
  ]
}
