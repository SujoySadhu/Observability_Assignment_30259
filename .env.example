# Copy to .env and change the values. .env is git-ignored; never commit it.
POSTGRES_USER=orders
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=orders

# Deliberate flaws (docs/known-flaws.md). Empty value = all flaws off.
FLAWS=slow_queries,memory_leak,coupon_bug,slow_login

# Grafana admin login (Task 2). Change the password in .env.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
SMTP_USER=yourname@gmail.com
SMTP_PASSWORD=abcdefghijklmnop
ALERT_EMAIL_TO=yourname@gmail.com
